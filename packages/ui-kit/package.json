{
  "name": "ui-kit",
  "version": "1.0.0",
  "description": "",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "private": true,
  "scripts": {
    "prepare": "pnpm run build",
    "build": "babel src --out-dir dist --extensions .ts,.tsx --delete-dir-on-start --config-file ./babel.config.js --root-mode=root --no-babelrc && tsc -p tsconfig.build.json",
    "dev": "babel src --out-dir dist --extensions .ts,.tsx --source-maps inline --watch --config-file ./babel.config.js --root-mode=root --no-babelrc & tsc -p tsconfig.build.json --watch",
    "align-deps": "rnx-align-deps --write --verbose"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "react": "19.1.0",
    "react-native": "0.81.4"
  },
  "devDependencies": {
    "@babel/cli": "^7.28.3",
    "@react-native/babel-preset": "0.78.2",
    "@types/react": "^19.0.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "typescript": "^5.6.3",
    "@rnx-kit/align-deps": "^2.5.1",
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@swc/helpers": "^0.5.17"
  }
}
